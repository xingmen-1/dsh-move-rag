{
  "name": "dsh-move-rag",
  "version": "0.1.0",
  "description": "Local knowledge base for DeepSeek Harness that lives on your desktop: drag files onto an always-on-top icon to ingest them, search them from the same panel, and let the agent query them.",
  "type": "module",
  "main": "entry.js",
  "exports": {
    ".": "./entry.js",
    "./package.json": "./package.json"
  },
  "files": [
    "entry.js",
    "impl.js",
    "engine.js",
    "desktop.ps1",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "cordis-plugin",
    "rag",
    "knowledge-base",
    "retrieval",
    "desktop",
    "winforms"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.19"
  },
  "os": [
    "win32"
  ],
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xingmen-1/dsh-move-rag.git"
  },
  "bugs": {
    "url": "https://github.com/xingmen-1/dsh-move-rag/issues"
  },
  "homepage": "https://github.com/xingmen-1/dsh-move-rag#readme"
}
